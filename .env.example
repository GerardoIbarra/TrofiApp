# Copiar a .env (o .env.local para overrides locales, no versionado) y completar valores.

# Base URL del backend. Si se omite, cae a http://localhost:8000/api (services/api.ts)
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# API key de Google Maps para Android (app.config.js). GOOGLE_MAPS_API_KEY es el fallback
# si esta no está definida.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# DSN del proyecto en Sentry (observabilidad de errores).
EXPO_PUBLIC_SENTRY_DSN=

# Activa logs verbosos en desarrollo (services/logger.ts). Valores esperados: "true" | "false".
EXPO_PUBLIC_DEBUG_LOGS=false

# EXPO_OS es inyectada automáticamente por el runtime de Expo — no configurar manualmente.
