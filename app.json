{
  "expo": {
    "name": "TrofiApp",
    "slug": "TrofiApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trofiapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jugardo.trofiapp"
    },
    "android": {
      "package": "com.jugardo.trofiapp",
      "adaptiveIcon": {
        "backgroundColor": "#0A192F",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0A192F",
          "dark": {
            "backgroundColor": "#0A192F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "ef2fcc5a-8ec9-40b3-bf4d-b11ccc316b44"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ef2fcc5a-8ec9-40b3-bf4d-b11ccc316b44"
    }
  }
}
